{
  "name": "gophergains",
  "version": "3.0.0",
  "productName": "GopherGains",
  "description": "Spreads trading journal for Tradier",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.gophergains.app",
    "files": [
      "src/**/*",
      "app/frontend/**/*",
      "build/icons/**/*"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "dmg": {
      "contents": [
        { "x": 150, "y": 200, "type": "file" },
        { "x": 390, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
